---
import { company } from '../config/company.ts';
---

<section class="hero">
  <div class="hero-art" aria-hidden="true">
    <canvas class="hero-canvas" data-streaks></canvas>
  </div>
  <div class="hero-copy">
    <h1>Zaplecze dla agentów&nbsp;AI.</h1>
    <p class="hero-sub">
      Infrastruktura dla agentów, automatyzacja na własnym serwerze i&nbsp;testy bezpieczeństwa. Stawiamy, uruchamiamy, sprawdzamy.
    </p>
  </div>
  <div class="hero-cta">
    <a class="btn" href="/kontakt/">Umów rozmowę</a>
    {company.declarations.responseTime && <p class="note">Odpowiadamy w {company.declarations.responseTime}</p>}
    <p class="note hero-links">
      <a href="#konsola" data-open-console>Otwórz konsolę <kbd class="kbd mono">/</kbd></a>
      <span aria-hidden="true">|</span>
      <a href="/jak-pracujemy/">Jak pracujemy</a>
    </p>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-streaks]');
  if (canvas) {
    const start = (): void => {
      void import('../lib/streaks/mount.ts').then((m) => m.mountStreaks(canvas));
    };
    const idle = (): void => {
      if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 2000 });
      else setTimeout(start, 300);
    };
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }
</script>

<style is:global>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    min-height: max(100svh, 760px);
    padding: calc(var(--nav-h) + var(--nav-top)) var(--gutter) var(--s-12);
    text-align: center;
    isolation: isolate;
    /* Tło wchodzi ze skalą 1,04 — nie może na ten czas poszerzać strony. */
    overflow-x: clip;
  }
  .hero-art {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: -1;
    width: min(100%, 1200px);
    height: 895px;
    transform: translateX(-50%);
    background: url('/art/hero-1200.webp') center top / auto 100% no-repeat;
    animation: hero-art-in 1.4s var(--ease-out-cubic) 0.1s both;
  }
  .hero-canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .hero-canvas.is-live {
    opacity: 1;
  }
  @keyframes hero-art-in {
    from {
      opacity: 0;
      transform: translateX(-50%) scale(1.04);
    }
  }
  .hero-copy {
    align-self: center;
    display: grid;
    justify-items: center;
    gap: var(--s-32);
    padding-bottom: var(--s-24);
  }
  .hero h1 {
    max-width: 560px;
    font-size: var(--fs-64);
    font-weight: var(--w-semibold);
    line-height: 1.1;
    letter-spacing: -0.5px;
    text-wrap: balance;
    text-shadow: 0 2px 30px rgb(7 8 10 / 0.35);
  }
  .hero-sub {
    max-width: 500px;
    font-size: var(--fs-18);
    font-weight: var(--w-regular);
    line-height: 1.3;
    letter-spacing: 0.2px;
    text-wrap: balance;
    text-shadow: 0 1px 20px rgb(7 8 10 / 0.5);
  }
  .hero-cta {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
  }
  .hero-cta .btn {
    margin-bottom: var(--s-16);
  }
  .hero-links {
    display: flex;
    align-items: center;
    gap: var(--s-12);
  }
  .hero-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    min-height: var(--tap);
    transition: color var(--t-fast) var(--ease);
  }
  .hero-links a:hover {
    color: var(--fg);
  }
  .hero-links .kbd {
    min-width: 20px;
    height: 20px;
  }
  @media (max-width: 720px) {
    .hero {
      min-height: 0;
      padding-top: 0;
      grid-template-rows: auto auto;
    }
    .hero-art {
      width: 100%;
      height: 560px;
      background-image: url('/art/hero-780.webp');
    }
    .hero-copy {
      min-height: 560px;
      align-content: center;
      gap: var(--s-24);
      padding-top: var(--s-48);
      padding-bottom: 0;
    }
    .hero h1 {
      max-width: 340px;
      font-size: var(--fs-36);
      letter-spacing: -0.3px;
    }
    .hero-sub {
      max-width: 330px;
      font-size: var(--fs-14);
      line-height: 1.45;
    }
    .hero-links .kbd {
      display: none;
    }
  }
</style>
