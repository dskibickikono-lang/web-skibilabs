---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  /** Pokazać przycisk kontaktu i odnośnik do konsoli. */
  actions?: boolean;
}
const { eyebrow, title, lead, actions = true } = Astro.props;
---

<section class="page-hero">
  <div class="container-sm">
    <div class="page-hero-inner">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      {
        actions && (
          <div class="page-actions">
            <a class="btn" href="/kontakt/">Umów rozmowę</a>
            <a class="link" href="/konsola/">
              Zobacz w konsoli demo
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8h10M9.25 4.25 13 8l-3.75 3.75" />
              </svg>
            </a>
          </div>
        )
      }
    </div>
    <slot />
  </div>
</section>
