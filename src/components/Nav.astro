---
import { CONTACT, NAV } from '../config/site.ts';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const current = (href: string): boolean => path === href || path === href.replace(/\/$/, '');
---

<header class="nav" data-nav>
  <div class="nav-card">
    <a class="nav-logo" href="/" aria-label="Skibi Labs — strona główna"><Logo /><span>Skibi Labs</span></a>
    <nav class="nav-links" aria-label="Główna">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn nav-cta" href={CONTACT.href}>{CONTACT.label}</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <span class="nav-burger" aria-hidden="true"><i></i><i></i></span>
    </button>
    <div class="nav-menu" id="nav-menu" data-nav-menu>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn" href={CONTACT.href}>{CONTACT.label}</a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  if (nav && toggle) {
    const set = (open: boolean): void => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(!nav.classList.contains('is-open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        set(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 961px)').addEventListener('change', () => set(false));
  }
</script>

<style is:global>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding: var(--nav-top) var(--gutter) 0;
    pointer-events: none;
  }
  .nav-card {
    position: relative;
    display: flex;
    align-items: center;
    width: min(100%, var(--container));
    min-height: var(--nav-h);
    margin-inline: auto;
    padding: 0 var(--s-32);
    border-radius: var(--r-16);
    border: 1px solid var(--line);
    background: linear-gradient(137deg, rgb(17 18 20 / 0.75) 4.87%, rgb(12 13 15 / 0.9) 75.88%);
    box-shadow: inset 0 1px 1px 0 rgb(255 255 255 / 0.15);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    pointer-events: auto;
  }
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    font-size: var(--fs-16);
    font-weight: var(--w-semibold);
    line-height: 1.5;
    letter-spacing: 0.1px;
  }
  .nav-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .nav-links ul {
    display: flex;
    gap: var(--s-16);
  }
  .nav-links a,
  .nav-menu li a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--s-8);
    border-radius: var(--r-6);
    font-size: var(--fs-14);
    font-weight: var(--w-medium);
    line-height: 20px;
    letter-spacing: 0.2px;
    color: var(--fg-2);
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease-in-out);
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'],
  .nav-menu li a:hover,
  .nav-menu li a[aria-current='page'] {
    color: var(--fg);
  }
  .nav-cta {
    margin-left: auto;
  }
  .nav-toggle,
  .nav-menu {
    display: none;
  }
  @media (max-width: 960px) {
    .nav-card {
      flex-wrap: wrap;
      padding: 0 var(--s-16);
      transition: none;
    }
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-logo {
      min-height: calc(var(--nav-h) - 2px);
    }
    .nav-toggle {
      display: grid;
      place-items: center;
      width: var(--tap);
      height: var(--tap);
      margin-left: auto;
      margin-right: -8px;
      border-radius: var(--r-8);
    }
    .nav-burger {
      position: relative;
      width: 18px;
      height: 10px;
    }
    .nav-burger i {
      position: absolute;
      left: 0;
      width: 18px;
      height: 1.5px;
      border-radius: 1px;
      background: var(--fg);
      transition: transform var(--t-base) var(--ease);
    }
    .nav-burger i:first-child {
      top: 0;
    }
    .nav-burger i:last-child {
      bottom: 0;
    }
    .nav.is-open .nav-burger i:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }
    .nav.is-open .nav-burger i:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }
    .nav.is-open .nav-card {
      background: rgb(12 13 15 / 0.97);
    }
    .nav.is-open .nav-menu {
      display: block;
      flex-basis: 100%;
      padding: var(--s-8) 0 var(--s-16);
      border-top: 1px solid var(--line);
    }
    .nav-menu li a {
      min-height: 44px;
      padding: 0;
    }
    .nav-menu .btn {
      width: 100%;
      margin-top: var(--s-16);
    }
  }
  /* Bez JS zamiast przycisku menu zostają odnośniki w przewijanym wierszu. */
  @media (max-width: 960px) {
    html:not(.js) .nav-toggle {
      display: none;
    }
    html:not(.js) .nav-links {
      display: block;
      position: static;
      transform: none;
      min-width: 0;
      margin-left: var(--s-16);
      overflow-x: auto;
      scrollbar-width: none;
    }
    html:not(.js) .nav-links ul {
      gap: var(--s-8);
    }
  }
</style>
